{
  "name": "rs3-clone",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --no-binary-patching -- --locked",
    "build:mac": "node scripts/build-macos-offline.mjs",
    "prepare:youtube": "node scripts/prepare-youtube-tools.mjs --download",
    "test:native:recordings": "node scripts/verify-private-recordings.mjs",
    "test:youtube-tools": "node --test scripts/youtube-tool-tests.mjs && node scripts/verify-youtube-tools.mjs",
    "test:release": "node --test scripts/release-tests.mjs scripts/release-policy-tests.mjs scripts/branding-tests.mjs scripts/windows-branding-tests.mjs scripts/consolidation-tests.mjs",
    "test:branding": "node scripts/verify-branding.mjs",
    "test:plots": "node scripts/verify-plots.mjs",
    "test:sidebar": "node scripts/verify-sidebar.mjs",
    "test:motion": "node scripts/verify-motion.mjs",
    "test:library:premium": "node scripts/verify-library-premium.mjs",
    "test:workflow": "node scripts/verify-workflow.mjs",
    "test:advanced": "node scripts/verify-advanced.mjs",
    "test:coach": "node scripts/verify-coach.mjs",
    "test:coach:premium": "node scripts/verify-coach-premium.mjs",
    "test:canvas": "node scripts/verify-canvas.mjs",
    "test:video": "node scripts/verify-video.mjs && node scripts/verify-video-integration.mjs",
    "build:website": "tsc -p tsconfig.website.json && node scripts/build-website.mjs",
    "test:website": "node scripts/verify-website.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "motion": "^14.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}
